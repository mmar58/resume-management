# =============================================================================
# Frontend Environment Configuration — EXAMPLE
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# SvelteKit exposes variables prefixed with PUBLIC_ to the browser.
# Variables WITHOUT the PUBLIC_ prefix are server-only (used in +server.ts / hooks).
# =============================================================================

# Base URL of the ASP.NET Core backend API (no trailing slash)
PUBLIC_API_BASE_URL=http://localhost:5000

# SignalR hub URL for real-time discussions
PUBLIC_SIGNALR_HUB_URL=http://localhost:5000/hubs/discussion

# Default locale: en | bn  (en = English, bn = Bengali)
PUBLIC_DEFAULT_LOCALE=en

# Default theme: light | dark
PUBLIC_DEFAULT_THEME=light
