# =============================================================================
# Backend Environment Configuration — EXAMPLE
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# =============================================================================
# Database — PostgreSQL (e.g. Aiven, Supabase, Neon, local)
# =============================================================================
DB_HOST=your-postgres-host.example.com
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=5432
# Path to the server CA certificate for SSL verification (relative to project root)
# Leave blank or remove if your provider does not require a custom CA
DB_CA_PATH=ca.pem

# =============================================================================
# JWT Authentication
# =============================================================================
# Must be a long, random, secret string (≥ 64 characters recommended for HS256)
JWT_SECRET=replace-with-a-very-long-random-secret-string-do-not-use-this-value
JWT_ISSUER=resume-management-backend
JWT_AUDIENCE=resume-management-frontend
# Access token lifetime in minutes
JWT_EXPIRES_MINUTES=60
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=7

# =============================================================================
# OAuth — Google
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# OAuth — GitHub
# Get credentials at: https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/github/callback
# =============================================================================
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# =============================================================================
# Cloudinary (Image / File Storage)
# Get credentials at: https://cloudinary.com/console
# Never store uploaded images in the database or on the web server.
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =============================================================================
# CORS — allowed frontend origins (comma-separated, no trailing slash)
# =============================================================================
APP_ORIGINS=http://localhost:5173,http://localhost:5174

# =============================================================================
# App
# =============================================================================
# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
# URL(s) the backend listens on (semicolon-separated)
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001
